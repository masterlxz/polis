# Imagem de PRODUÇÃO do Django (ADR 0011). Diferente da de desenvolvimento (`Dockerfile`):
# sem dependências de teste, código copiado (não montado como volume), arquivos estáticos já
# coletados e gunicorn no lugar do `runserver`. O proxy (Caddy) vem no Compose de produção.
FROM python:3.15-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/opt/venv/bin:$PATH" \
    WEB_CONCURRENCY=2

RUN useradd --create-home --uid 1000 app \
    && mkdir /opt/venv /app \
    && chown app:app /opt/venv /app

USER app
WORKDIR /app

# Dependências antes do código; `--no-dev` deixa pytest e ruff de fora da imagem.
COPY --chown=app:app pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev

COPY --chown=app:app . .

# O `collectstatic` só precisa de um `SECRET_KEY` para importar as configurações; a chave real
# nunca entra na imagem e vem do ambiente na hora de rodar.
RUN DJANGO_SECRET_KEY=so-para-o-build python manage.py collectstatic --noinput

EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000"]
