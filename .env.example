# Copie para `.env` (ignorado pelo git) e preencha. Nunca commite valores reais.

# Obrigatória: sem ela o projeto não sobe. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Opcional. "1" ou "true" liga o modo de depuração; ausente = desligado.
DJANGO_DEBUG=

# Hosts permitidos, separados por vírgula (obrigatório com DJANGO_DEBUG desligado em produção).
DJANGO_ALLOWED_HOSTS=

# Produção atrás de um proxy com TLS (ADR 0011). Todas opcionais; sem elas, vale o
# comportamento de desenvolvimento. Valor inválido recusa subir.
# "1" ou "true": cookies de sessão e CSRF só por HTTPS.
DJANGO_HTTPS=
# "1" ou "true": confia no X-Forwarded-Proto. SÓ com o proxy sobrescrevendo o cabeçalho e sendo
# o único caminho até o Django; senão um cliente forja o cabeçalho.
DJANGO_BEHIND_PROXY=
# Segundos de HSTS (inteiro). Vazio ou 0 = desligado; ele "gruda" no navegador, então só ligue
# quando decidir abrir ao público.
DJANGO_HSTS_SECONDS=
# Origens confiáveis para o CSRF, separadas por vírgula, com https:// (por exemplo o domínio do
# admin). Cada uma precisa começar com https:// ou http://.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Backup (compose.prod.yaml, ADR 0025). Todas obrigatórias na produção. Armazenamento
# S3-compatível no Brasil (ADR 0011). Prefira uma credencial só de ESCRITA e regra de ciclo de
# vida do provedor: a do servidor não deveria poder apagar tudo.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Chaves PÚBLICAS do age (age1...), separadas por vírgula. Use duas: a sua e uma de recuperação
# guardada offline. A chave PRIVADA nunca vai para o servidor; perdê-la é perder os backups.
BACKUP_AGE_RECIPIENTS=
# Dias de retenção (padrão 14).
BACKUP_RETENCAO_DIAS=

# Docker Compose: POSTGRES_PASSWORD e DJANGO_SECRET_KEY são obrigatórios (o Compose recusa
# subir sem eles). POSTGRES_HOST e POSTGRES_PORT abaixo valem fora do Docker; dentro do
# Compose o `web` usa o host `db`, definido no compose.yaml.
POSTGRES_DB=polis
POSTGRES_USER=polis
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
