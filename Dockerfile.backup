# Imagem do BACKUP (ADR 0011, 0025). Base `postgres:18` para o `pg_dump`/`pg_restore` ter a
# mesma versão do servidor; `age` cifra com chave pública (a privada nunca fica no servidor) e
# `rclone` fala com qualquer armazenamento S3-compatível. Os pacotes vêm do Debian da imagem base
# (versão do repositório, não fixada além disso). Roda sem privilégio de root.
FROM postgres:18

RUN apt-get update \
    && apt-get install --no-install-recommends -y age rclone \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY scripts/backup.sh scripts/backup-laco.sh scripts/restaurar.sh scripts/

# O entrypoint da imagem do Postgres tenta iniciar o servidor; aqui só queremos os comandos.
ENTRYPOINT []
USER postgres
CMD ["bash", "scripts/backup-laco.sh"]
